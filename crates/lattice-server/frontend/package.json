{
  "name": "@lattice/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.14.x",
    "npm": "11.11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:types": "cargo test -p lattice-server export_bindings -- --nocapture",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:topology-reflection": "playwright test tests/e2e/topology-reflection.spec.ts"
  },
  "dependencies": {
    "@tabler/icons": "3.41.1",
    "lit": "3.3.2",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "@types/three": "0.183.1",
    "typescript": "6.0.2",
    "vite": "8.0.3",
    "vitest": "4.1.2"
  }
}
